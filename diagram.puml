@startuml Diagram

skinparam classAttributeIconSize 0
skinparam monochrome false
skinparam shadowing false
skinparam packageStyle rectangle

title Online Course Enrollment System - Backend UML Diagram

package "model" {

class Student {
    - int studentId
    - String name
    + getStudentId()
    + getName()
}

class Instructor {
    - int instructorId
    - String name
    + getInstructorId()
    + getName()
}

class Schedule {
    - String day
    - String time
    + getDay()
    + getTime()
}

class Course {
    - int courseId
    - String title
    - double fee
    - Instructor instructor
    - Schedule schedule

    + getCourseId()
    + getTitle()
    + getFee()
    + getInstructor()
    + getSchedule()
}

class Enrollment {
    - int studentId
    - int courseId
    - String courseTitle
    - double fee
    - boolean paid

    + getStudentId()
    + getCourseId()
    + getCourseTitle()
    + getFee()
    + isPaid()
    + setPaid(boolean)
}

class Department {
    - String name
    - List<Integer> courseIds
    - List<Integer> instructorIds

    + getName()
    + getCourseIds()
    + getInstructorIds()
    + addCourseId(int)
    + addInstructorId(int)
    + removeCourseId(int)
    + removeInstructorId(int)
}

}

package "util" {

class FileManager {
    + {static} readCSV(Path) : List<String[]>
    + {static} writeCSV(Path, List<String>)
}

}

package "service" {

interface DataService<T> {
    + add(T item) : boolean
    + delete(int id) : boolean
    + getAll() : List<T>
    + findById(int id) : Optional<T>
}

class StudentService {
    - Path filePath
    - List<Student> students

    + add(Student)
    + delete(int)
    + getAll()
    + findById(int)
    + addStudent(Student)
    + deleteStudent(int)
}

class InstructorService {
    - Path filePath
    - List<Instructor> instructors

    + add(Instructor)
    + delete(int)
    + getAll()
    + findById(int)
    + addInstructor(Instructor)
    + deleteInstructor(int)
}

class CourseService {
    - Path filePath
    - List<Course> courses

    + add(Course)
    + delete(int)
    + getAll()
    + findById(int)

    + addCourse(Course)
    + deleteCourse(int)

    + assignInstructorToCourse(int, Instructor)
    + unassignInstructorFromCourses(int)
}

class DepartmentService {
    - CourseService courseService
    - InstructorService instructorService
    - Path filePath
    - List<Department> departments

    + addDepartment(String)
    + deleteDepartment(String)

    + addCourseToDepartment(String,int)
    + addInstructorToDepartment(String,int)

    + removeCourseFromDepartments(int)
    + removeInstructorFromDepartments(int)

    + getCoursesForDepartment(String)
}

class EnrollmentService {
    - CourseService courseService
    - DepartmentService departmentService
    - Path filePath
    - List<Enrollment> enrollments

    + selectCourse(int,int)
    + selectDepartment(int,String)

    + viewEnrollments(int)

    + pendingFees(int)
    + payAllPendingFees(int)

    + deleteEnrollment(int,int)

    + removeEnrollmentsByStudent(int)
    + removeEnrollmentsByCourse(int)
}

class AuthService {
    + login(String,String)
}

class FeesService {
    + calculatePendingFees(List<Enrollment>)
}

}

' =========================
' INTERFACE IMPLEMENTATION
' =========================

DataService <|.. StudentService
DataService <|.. InstructorService
DataService <|.. CourseService

' =========================
' MODEL RELATIONSHIPS
' =========================

Course --> Instructor
Course --> Schedule

Department --> Course
Enrollment --> Course
Enrollment --> Student

' =========================
' SERVICE DEPENDENCIES
' =========================

StudentService --> Student
InstructorService --> Instructor
CourseService --> Course

DepartmentService --> Department
DepartmentService --> CourseService
DepartmentService --> InstructorService

EnrollmentService --> Enrollment
EnrollmentService --> CourseService
EnrollmentService --> DepartmentService

CourseService --> Instructor
CourseService --> Schedule

' =========================
' FILE MANAGER USAGE
' =========================

StudentService --> FileManager
InstructorService --> FileManager
CourseService --> FileManager
DepartmentService --> FileManager
EnrollmentService --> FileManager


